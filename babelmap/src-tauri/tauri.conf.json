{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BabelMap",
  "version": "1.0.0",
  "identifier": "com.babelstone.babelmap",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "BabelMap",
        "label": "main",
        "width": 1280,
        "height": 960,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:18080; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/babelmap-backend"
    ],
    "resources": {
      "../../babellib/data": "data"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
